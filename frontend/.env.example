# Copy to frontend/.env. No secrets live here.

# Stop create-react-app from opening a browser tab on `npm start`
BROWSER=none

# Where the Flask API is served (backend/app.py default). When the page is opened via a
# LAN address (http://10.x.x.x:3001) the app automatically swaps the loopback host for the
# page's host, so this value works for both http://localhost:3000 and LAN access as long
# as the backend runs with FLASK_HOST=0.0.0.0.
REACT_APP_API_URL=http://127.0.0.1:5000
