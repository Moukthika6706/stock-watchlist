# Copy to backend/.env and fill in. backend/.env is gitignored.

# MySQL
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_NAME=stock_watchlist

# Twelve Data (free tier: 800 credits/day, 8/min). Only needed for live polling
# and for adding a ticker that has never been seen; the demo needs neither.
API_KEY=your-twelve-data-key

# flask-jwt-extended signing key (24h access tokens)
JWT_SECRET_KEY=change-me-too

# Demo safety: while true, POST /poll-prices answers 423 instead of overwriting
# the seeded demo snapshots with frozen real prices. UNSET ALSO COUNTS AS TRUE
# (fail-safe). Set DEMO_MODE=false and restart the server to poll for real.
DEMO_MODE=true

# Demo account created/used by seed_demo_data.py --arm (also listed in DEMO.md)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me
DEMO_NAME=Demo Investor

# Optional: comma-separated origins allowed by CORS (default: localhost:3000 and 127.0.0.1:3000)
# FRONTEND_ORIGINS=http://localhost:3000
